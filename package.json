{
  "name": "guiye",
  "private": true,
  "version": "0.1.0",
  "description": "归页 —— 可自部署的个人起始页 / 书签管理 / 组件式主页",
  "license": "MIT",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "pnpm --filter @guiye/web dev",
    "build": "pnpm --filter @guiye/web build",
    "build:ext": "pnpm --filter @guiye/extension build",
    "zip:ext": "pnpm --filter @guiye/extension zip",
    "build:all": "pnpm build && pnpm build:ext",
    "preview": "pnpm --filter @guiye/web preview",
    "typecheck": "pnpm --filter @guiye/web typecheck",
    "test": "pnpm --filter @guiye/shared test"
  }
}
